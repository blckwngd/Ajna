{
  "name": "ajna",
  "version": "0.1.0",
  "description": "Ajna - Geo-referenced WebXR multiplayer demo with BabylonJS and PocketBase",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "serve-client": "npx serve client",
    "start:all": "concurrently \"npm run start\" \"npm run serve-client\"",
    "start:dev": "concurrently \"npm run start\" \"http-server client -p 443 -S -C cert.pem -o index-map.html\"",
    "build": "webpack",
    "dev": "webpack --watch",
    "pocketbase": "pocketbase\\pocketbase.exe serve --http=0.0.0.0:8090",
    "caddy": "caddy run --config Caddyfile.prod",
    "stack": "concurrently --kill-others --names pb,wp,api,caddy -c green,yellow,cyan,magenta \"npm:pocketbase\" \"npm:dev\" \"npm:start\" \"npm:caddy\"",
    "stack:all": "concurrently --kill-others --names pb,wp,api,caddy,poi,ais,wigle,director -c green,yellow,cyan,magenta,blue,red,gray,white \"npm:pocketbase\" \"npm:dev\" \"npm:start\" \"npm:caddy\" \"node scripts/wait-stack.mjs && node agents/poi-bridge.mjs\" \"node scripts/wait-stack.mjs && node agents/ais-bridge.mjs\" \"node scripts/wait-stack.mjs && node agents/wigle-bridge.mjs\" \"node scripts/wait-stack.mjs && node agents/world-director.mjs\"",
    "ais": "node agents/ais-bridge.mjs",
    "adsb": "node agents/adsb-bridge.mjs",
    "poi": "node agents/poi-bridge.mjs",
    "wigle": "node agents/wigle-bridge.mjs",
    "wand-agent": "node agents/wand-agent.mjs",
    "director": "node agents/world-director.mjs",
    "ha-gateway": "node agents/homeassistant-gateway.mjs",
    "ha-gateway:setup": "node agents/homeassistant-gateway.mjs --setup",
    "uwb-anchors": "node agents/uwb-anchors.mjs",
    "mobile:sync": "webpack && cap sync android",
    "mobile:run": "webpack && node scripts/mobile-run.mjs",
    "mobile:open": "cap open android",
    "android:trust-caddy": "node scripts/android-trust-caddy.mjs",
    "deploy": "bash scripts/deploy.sh",
    "test:quests": "node tests/run-quests.mjs",
    "test:privacy": "node tests/run-privacy.mjs",
    "test:ui": "node tests/run-ui.mjs",
    "test:landing": "node tests/run-landing.mjs",
    "test": "npm run test:ui && npm run test:landing && npm run test:quests && npm run test:privacy"
  },
  "dependencies": {
    "@babylonjs/core": "^8.54.3",
    "@babylonjs/inspector": "^8.55.3",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "3d-tiles-renderer": "^0.3.46",
    "aedes": "^1.1.1",
    "babylonjs-gui": "^8.54.1",
    "eventsource": "^4.1.0",
    "express": "^4.19.2",
    "mqtt": "^5.15.2",
    "pocketbase": "^0.21.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@babylonjs/materials": "^8.55.3",
    "@capacitor/cli": "^8.4.0",
    "concurrently": "^8.2.2",
    "css-loader": "^7.1.4",
    "nodemon": "^3.1.0",
    "serve": "^14.2.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1"
  }
}
