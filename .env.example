# Credentials für das Ajna-CLI-Helper-Tool (tools/ajna.mjs).
#
# Kopieren als `.env` und Werte eintragen. Die `.env` ist gitignored,
# diese `.env.example` bleibt im Repo als Vorlage.
#
#     cp .env.example .env
#     # → Werte unten ausfüllen

# Backend-URL für Agents/Tools. WICHTIG: muss BEIDES bedienen —
#   • PocketBase  (/api, /_/, Realtime/SSE)            → 127.0.0.1:8090
#   • Express-API (/ajnaapi/* : Interest-Areas, Geo)   → 127.0.0.1:3000
# Beides liegt hinter CADDY. Der PB-Direkt-Default unten (Loopback, an Caddy
# vorbei) kennt KEIN /ajnaapi → Agents, die das nutzen (poi, wigle, ais,
# world-director), bekommen sonst "File not found." (404).
#
#   • Nur PB-Tooling, keine /ajnaapi-Calls:  http://127.0.0.1:8090  reicht.
#   • Agents mit /ajnaapi ODER Produktion:   die CADDY-URL eintragen, z. B.
#       lokal:      https://localhost        (Caddys interne CA; Node startet
#                                             sich mit --use-system-ca neu,
#                                             sofern unterstützt)
#       Produktion: https://ajna.example.de  (öffentliches Let's-Encrypt-Zert,
#                                             von Node ohne Zusatz vertraut)
#   Opt-out des CA-Re-Exec: AJNA_NO_SYSTEM_CA=1 (z. B. mit NODE_EXTRA_CA_CERTS).
AJNA_URL=http://127.0.0.1:8090

# Dedizierter PB-User für Tooling-Zugriff. KEIN Admin-Account verwenden.
# Im PB-Admin (https://localhost/_/) einen User in der `users`-Collection
# anlegen, in eine Test-Gruppe stecken und der Gruppe die nötigen Rechte
# auf den gewünschten Objekten geben.
AJNA_USER=claude@ajna.local
AJNA_PASS=

# ──────────────────────────────────────────────────────────────────────
# AIS-Bridge (agents/ais-bridge.mjs) — Schiffspositionen aus aisstream.io
# in Ajna spiegeln. Konfig wird nur ausgewertet, wenn der Agent läuft.
# ──────────────────────────────────────────────────────────────────────

# API-Key von https://aisstream.io
AISSTREAM_API_KEY=

# Zentrum + Radius der BoundingBox in km. Default: Hamburger Hafen.
AIS_CENTER_LAT=53.5511
AIS_CENTER_LON=9.9937
AIS_RADIUS_KM=10

# Min. Sekunden zwischen PB-Updates pro Schiff (Throttle).
AIS_UPDATE_INTERVAL_S=5

# Schiffe, die so lange keine Message mehr gesendet haben (typisch: sie
# haben die BoundingBox verlassen), werden aus PB entfernt.
AIS_STALE_TIMEOUT_S=600

# ──────────────────────────────────────────────────────────────────────
# POI-Bridge (agents/poi-bridge.mjs) — Overpass-POIs als Ajna-Objekte
# anlegen (statisch, einmaliger Sync per Default).
# ──────────────────────────────────────────────────────────────────────

POI_CENTER_LAT=50.3569
POI_CENTER_LON=7.5890
POI_RADIUS_KM=1

# Filter-Set des `/ajnaapi/geo/pois`-Endpoints: common | amenity | shops | tourism
POI_FILTER=common

# Refresh-Intervall in Sekunden (Default: 120, kontinuierlich). 0 = einmaliger Sync, dann exit.
POI_REFRESH_S=120

# WIGLE.NET — Zugangsdaten von https://wigle.net (Account → API: "API Name" / "API Token")
WIGLE_API_NAME=dein-wigle-api-name
WIGLE_API_TOKEN=dein-wigle-api-token

# World-Director: Zentrum + Radius des bevölkerten Bereichs
# (Fallback, wenn keine Interessensbereiche aktiv sind).
WD_CENTER_LAT=50.456774320442165
WD_CENTER_LON=7.533048625628973
WD_RADIUS_M=600